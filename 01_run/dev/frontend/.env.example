# Configuración pública del proyecto de Firebase (Spark plan / gratis).
# Copiar a .env.local y completar con los valores del proyecto real
# (Firebase Console > Configuración del proyecto > Tus apps > SDK config).
# Estos valores son públicos por diseño (no son secretos): la seguridad
# real vive en firestore.rules.
#
# Nota: prefijo VITE_ (no NEXT_PUBLIC_) — es la convención de Vite para
# exponer variables al bundle del cliente.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
